{
  "name": "JUSSAA Website",

  "image": "mcr.microsoft.com/devcontainers/base:bookworm",

  "features": {
    "ghcr.io/devcontainers/features/ruby:2": {
      "version": "3.1"
    },
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },

  "forwardPorts": [4000, 35729],

  "portsAttributes": {
    "4000": {
      "label": "Jekyll preview",
      "onAutoForward": "openBrowser"
    },
    "35729": {
      "label": "Jekyll LiveReload",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },

  "postCreateCommand": "bundle install && npm ci && npx playwright install --with-deps chromium && sudo apt-get install -y xauth",

  "customizations": {
    "vscode": {
      "extensions": [
        "shopify.ruby-lsp"
      ]
    }
  },

  "remoteUser": "vscode"
}
